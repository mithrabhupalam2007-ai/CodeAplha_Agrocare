# =============================================================
# AgroShield server - environment variables
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file to version control.
# =============================================================

# Port the Express server listens on
PORT=5050

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/agroshield

# Secret used to sign JWT access tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# How long an access token stays valid (examples: 7d, 12h, 60m)
JWT_EXPIRES_IN=7d

# Comma separated list of trusted frontend origins for CORS
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000

# Set to "production" when deploying (enables secure cookies + stricter CORS)
NODE_ENV=development

# Seed / bootstrap admin account (used by `npm run create-admin`)
# The ADMIN_NAME doubles as the username accepted on the Admin Login page.
ADMIN_EMAIL=admin@agroshield.in
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=AgroShield Admin
